{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "humans-vs-ai",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "permissions": {
    "http": {
      "enable": true,
      "domains": ["api.openai.com"]
    },
    "redis": true,
    "reddit": {
      "scope": "moderator",
      "asUser": ["SUBMIT_COMMENT"]
    }
  },
  "menu": {
    "items": [
      {
        "label": "Create a new post",
        "description": "humans-vs-ai",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      },
      {
        "label": "Example form",
        "description": "Show a simple form",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/example-form"
      }
    ]
  },
  "forms": {
    "exampleForm": "/internal/form/example-submit"
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install",
    "onAppUpgrade": "/internal/triggers/on-app-upgrade"
  },
  "scheduler": {
    "tasks": {
      "resolve-daily-battle-edt": {
        "endpoint": "/internal/scheduler/resolve-daily-battle",
        "cron": "0 1 * * *"
      },
      "resolve-daily-battle-est": {
        "endpoint": "/internal/scheduler/resolve-daily-battle",
        "cron": "0 2 * * *"
      },
      "create-daily-battle-edt": {
        "endpoint": "/internal/scheduler/create-daily-battle",
        "cron": "1 1 * * *"
      },
      "create-daily-battle-est": {
        "endpoint": "/internal/scheduler/create-daily-battle",
        "cron": "1 2 * * *"
      }
    }
  },
  "settings": {
    "global": {
      "openai_api_key": {
        "type": "string",
        "label": "OpenAI API Key",
        "isSecret": true
      }
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "dev": {
    "subreddit": "humans_vs_ai_dev"
  }
}
